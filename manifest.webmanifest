{
  "id": "./",
  "name": "PoiWallet – point cards in one place",
  "short_name": "PoiWallet",
  "description": "All your point and loyalty cards in one place. Works offline. No account, no tracking.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fff5f1",
  "theme_color": "#e8604c",
  "categories": ["shopping", "lifestyle", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Add card", "url": "./#add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
